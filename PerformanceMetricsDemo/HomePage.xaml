<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sample.HomePage"
             Title="HomePage">
    <ScrollView>
    <VerticalStackLayout>
        <Button 
       Text="100"
       VerticalOptions="Center" 
       HorizontalOptions="Center" Clicked="Button_Clicked1" />
        <Button 
       Text="1000"
       VerticalOptions="Center" 
       HorizontalOptions="Center" Clicked="Button_Clicked1" />
        <Button 
       Text="10K"
       VerticalOptions="Center" 
       HorizontalOptions="Center" Clicked="Button_Clicked1" />
        <Button 
       Text="1L"
       VerticalOptions="Center" 
       HorizontalOptions="Center" Clicked="Button_Clicked1" />
        <Button 
       Text="10L"
       VerticalOptions="Center" 
       HorizontalOptions="Center" Clicked="Button_Clicked1" />

       <Button 
      Text="SfListView"
      VerticalOptions="Center" 
      HorizontalOptions="Center" Clicked="Button_Clicked" />

       <Button 
      Text="ListViewGrouping"
      VerticalOptions="Center" 
      HorizontalOptions="Center" Clicked="Button_Clicked" />

        <Button 
       Text="ListViewFiltering"
       VerticalOptions="Center" 
       HorizontalOptions="Center" Clicked="Button_Clicked" />

       <Button 
      Text="ListViewSorting"
      VerticalOptions="Center" 
      HorizontalOptions="Center" Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>